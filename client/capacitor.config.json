{
  "appId": "com.zenosolar.app",
  "appName": "Zeno Solar",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0d1117",
      "showSpinner": false,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d1117",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "none",
      "style": "DARK"
    }
  }
}
